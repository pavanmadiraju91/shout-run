{
  "name": "shout",
  "version": "0.1.0",
  "private": true,
  "description": "Terminal broadcasting for AI agents and developers",
  "homepage": "https://shout.run",
  "author": "pavanmadiraju91",
  "keywords": [
    "terminal",
    "broadcasting",
    "live",
    "developer-tools",
    "cli",
    "pty",
    "websocket",
    "xterm"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/pavanmadiraju91/shout-run.git"
  },
  "license": "MIT",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "clean": "turbo clean",
    "test": "turbo test",
    "test:ci": "turbo test -- --coverage"
  },
  "pnpm": {
    "overrides": {
      "flatted": ">=3.4.2",
      "undici": ">=7.28.0 <8",
      "ws": ">=8.21.0",
      "fast-uri": ">=3.1.4 <4",
      "qs": ">=6.15.3",
      "ip-address": ">=10.1.1",
      "esbuild": ">=0.28.1 <0.29",
      "vite": "8.1.5",
      "vitest": ">=3.2.6",
      "sharp": ">=0.35.0",
      "hono": ">=4.12.32",
      "postcss": ">=8.5.18",
      "js-yaml@^4": ">=4.3.0 <5",
      "brace-expansion@^1": ">=1.1.16 <2",
      "brace-expansion@^5": ">=5.0.8 <6",
      "body-parser": ">=2.3.0",
      "@hono/node-server": ">=2.0.5"
    }
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^4.1.0",
    "turbo": "^2.9.14",
    "typescript": "^5.7.0",
    "vite": "8.1.5",
    "vitest": "^4.1.0"
  }
}
